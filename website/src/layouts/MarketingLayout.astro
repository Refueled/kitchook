---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'KitchooK! — Markdown recipes, made portable.',
  description = 'Build a beautiful, portable static cookbook from ordinary Markdown recipes and colocated images.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fff8e7" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(Astro.url.pathname, 'https://kitchook.com')} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:image" content="https://kitchook.com/social-card.png" />
    <meta property="og:image:alt" content="KitchooK! — Markdown recipes, made portable." />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
