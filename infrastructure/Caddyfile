{
	admin off
	persist_config off
	auto_https off
}

http://:8080 {
	root * /srv/current

	route {
		encode zstd gzip

		header {
			Cache-Control "no-cache"
			Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
			Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), usb=()"
			Referrer-Policy "no-referrer"
			X-Content-Type-Options "nosniff"
			X-Frame-Options "DENY"
		}

		header -Server
		header /_astro/* Cache-Control "public, max-age=31536000, immutable"

		file_server
	}

	log {
		output stdout
		format console
	}
}
