---
import RecipeCard from '../components/RecipeCard.astro';
import SearchForm from '../components/SearchForm.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { instanceConfig } from '../lib/instance-config';
import { getPublishedRecipes } from '../lib/recipes';

const recipes = await getPublishedRecipes();
const recipeCount = `${recipes.length} published ${recipes.length === 1 ? 'recipe' : 'recipes'}`;
---

<BaseLayout
  title={instanceConfig.title}
  description={instanceConfig.description}
  showHeaderSearch={false}
>
  <section class="home-intro" aria-labelledby="home-title">
    <h1 id="home-title">Everything worth making</h1>
    <p>Pick a recipe, get cooking, and keep the screen clutter out of the kitchen.</p>
  </section>

  <section class="home-search" aria-label="Find a recipe">
    <SearchForm id="home-search" variant="home" />
  </section>

  <section aria-labelledby="recipes-heading">
    <div class="collection-heading">
      <h2 id="recipes-heading">All recipes</h2>
      <p class="recipe-count">{recipeCount}</p>
    </div>

    <div class="recipe-grid">
      {recipes.map((recipe) => <RecipeCard recipe={recipe} />)}
    </div>
  </section>
</BaseLayout>
