---
import { getPublishedRecipes } from '../lib/recipes';

const title = 'Kitchook';
const recipes = await getPublishedRecipes();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Kitchook is a static cookbook built from Markdown recipes."
    />
    <title>{title}</title>
  </head>
  <body>
    <main>
      <h1>{title}</h1>
      <p>Recipes published from the canonical Markdown collection.</p>

      <h2>Recipes</h2>
      <ul>
        {recipes.map((recipe) => (
          <li><a href={`/recipes/${recipe.id}/`}>{recipe.data.title}</a></li>
        ))}
      </ul>
    </main>
  </body>
</html>
