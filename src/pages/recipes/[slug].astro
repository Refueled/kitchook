---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import RecipeMeta from '../../components/RecipeMeta.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedRecipes, type RecipeEntry } from '../../lib/recipes';

export async function getStaticPaths() {
  const recipes = await getPublishedRecipes();

  return recipes.map((recipe) => ({
    params: { slug: recipe.id },
    props: { recipe },
  }));
}

interface Props {
  recipe: RecipeEntry;
}

const { recipe } = Astro.props;
const { Content } = await render(recipe);
const { data } = recipe;
const sourceLabel = data.source?.name ?? data.source?.url;
const hasMeta =
  data.prep_minutes !== undefined ||
  data.cook_minutes !== undefined ||
  data.total_minutes !== undefined ||
  data.servings !== undefined ||
  data.difficulty !== undefined;
const hasTaxonomy = data.tags.length > 0 || Boolean(data.source && sourceLabel);
const hasOverview = hasMeta || Boolean(data.image) || hasTaxonomy;
---

<BaseLayout
  title={`${data.title} | Kitchook`}
  description={data.description ?? `Cook ${data.title} with Kitchook.`}
  mainClass="recipe-page"
>
  <div class="recipe-shell">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/"><span aria-hidden="true">←</span>&nbsp; All recipes</a>
    </nav>

    <article>
      <header>
        <div class="recipe-heading-panel">
          <h1>{data.title}</h1>
          {data.description && <p class="recipe-heading-panel__description">{data.description}</p>}
        </div>

        {hasOverview && (
          <div class="recipe-overview">
            {hasMeta && (
              <RecipeMeta
                prepMinutes={data.prep_minutes}
                cookMinutes={data.cook_minutes}
                totalMinutes={data.total_minutes}
                servings={data.servings}
                difficulty={data.difficulty}
              />
            )}

            {data.image && (
              <figure class="recipe-hero">
                <Image
                  src={data.image}
                  alt={data.title}
                  widths={[640, 960, 1280]}
                  sizes="(max-width: 50rem) calc(100vw - 2rem), 48rem"
                />
              </figure>
            )}

            {hasTaxonomy && (
              <div class="recipe-taxonomy">
                {data.tags.length > 0 && (
                  <p class="recipe-tags">
                    <span class="recipe-tags__label">Tags:</span>
                    {data.tags.map((tag) => <span class="tag">{tag}</span>)}
                  </p>
                )}

                {data.source && sourceLabel && (
                  <p class="recipe-source">
                    <span class="recipe-source__label">Source:</span>{' '}
                    {data.source.url ? (
                      <a class="source-link" href={data.source.url}>{sourceLabel}</a>
                    ) : (
                      sourceLabel
                    )}
                  </p>
                )}
              </div>
            )}
          </div>
        )}
      </header>

      <div class="recipe-content">
        <Content />
      </div>
    </article>
  </div>
</BaseLayout>
