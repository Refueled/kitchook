---
import SearchForm from '../components/SearchForm.astro';
import { instanceConfig } from '../lib/instance-config';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  mainClass?: string;
  showHeaderSearch?: boolean;
}

const { title, description, mainClass, showHeaderSearch = false } = Astro.props;
const deploymentId = import.meta.env.PUBLIC_DEPLOYMENT_ID || 'local-build';
const canonicalUrl = instanceConfig.canonicalOrigin
  ? new URL(Astro.url.pathname, instanceConfig.canonicalOrigin).href
  : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <header class="site-header">
      <div class:list={["site-header__inner", { "site-header__inner--search": showHeaderSearch }]}>
        <a class="wordmark" href="/" aria-label={`${instanceConfig.title} home`}>{instanceConfig.title}</a>

        {showHeaderSearch && (
          <div class="desktop-header-search">
            <SearchForm id="desktop-header-search" variant="header" placeholder="Search recipes…" />
          </div>
        )}

        <p class="site-tagline">Cook from the source.</p>

        {showHeaderSearch && (
          <details class="mobile-header-search" data-header-search>
            <summary>
              <svg aria-hidden="true" viewBox="0 0 24 24" width="24" height="24">
                <circle cx="10.5" cy="10.5" r="6.5"></circle>
                <path d="m15.5 15.5 5 5"></path>
              </svg>
              <span class="visually-hidden">Search recipes</span>
            </summary>
            <div class="mobile-header-search__form">
              <SearchForm id="mobile-header-search" variant="header" placeholder="Search recipes…" />
            </div>
          </details>
        )}
      </div>
    </header>

    <main id="main-content" class:list={["site-main", mainClass]}>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer__inner">
        <p>
          <button
            class="footer-wordmark footer-deployment"
            type="button"
            data-deployment-copy
            data-deployment-id={deploymentId}
            aria-describedby="deployment-tooltip"
            aria-label={`${instanceConfig.title} deployment ${deploymentId}. Copy deployment identifier.`}
          >
            {instanceConfig.title}
            <span class="footer-deployment__tooltip" id="deployment-tooltip" role="tooltip" data-deployment-tooltip>
              Deployment {deploymentId} — click to copy
            </span>
          </button>
          — recipes kept in Markdown and served fresh.
          <span class="visually-hidden" aria-live="polite" data-deployment-status></span>
        </p>
        <a class="nav-link" href="#main-content">Back to top</a>
      </div>
    </footer>
    <script>
      import '../scripts/header-search';
      import '../scripts/deployment-copy';
    </script>
  </body>
</html>
